# =========================================================
# Docker Compose 部署参数模板
#
# - 复制本文件为仓库根目录 .env 后再运行 compose.yaml；不要在本文件放应用密钥。
# - 本文件只承担两件事：选择 APP_ENV，以及为 compose.yaml 提供变量替换值。
# - 应用自身只从根目录 .env 读取 APP_ENV；其余键由 Docker Compose 消费，应用不会读取。
# - 应用参数写 configs/.env.<APP_ENV>，凭据写 .secrets。
# =========================================================

# Compose 项目名，决定容器、网络与卷的命名前缀。
COMPOSE_PROJECT_NAME=agent-backend

# 应用环境，唯一来源：local / dev / test / prod。
# Compose 据此注入 APP_ENV，并只读挂载 configs/.env.<APP_ENV>；
# 与进程环境变量 APP_ENV 冲突时启动失败。
# 当前 logrotate sidecar 拓扑使用 prod：若改动本值，所选 configs/.env.<APP_ENV>
# 必须开启 LOG_WRITE_TO_FILE=true 并配置 LOG_BASE_DIR=logs，否则 sidecar 无输入。
APP_ENV=prod

# API 容器与 logrotate sidecar 使用的镜像名；改动需同步部署脚本和文档中的镜像名。
AGENT_BACKEND_IMAGE=agent-backend:prod
LOGROTATE_IMAGE=agent-backend-logrotate:3.21.0

# logrotate 镜像构建期的 Alpine 软件源；无法稳定访问官方 CDN 的主机改为内网镜像源。
LOGROTATE_ALPINE_REPOSITORY=https://dl-cdn.alpinelinux.org/alpine/v3.22

# 宿主机日志目录：应用写入 app.log，logrotate sidecar 读取同一目录；该目录需预先存在，
# 并允许镜像内 app 用户的数字 UID/GID 写入。
AGENT_BACKEND_LOG_DIR=/var/log/agent-backend

# --- API 服务 ---

# Uvicorn worker 进程数；Uvicorn 默认 1，这里的取值会覆盖该默认值，
# 调整时需与 API_CPUS 及数据库等下游连接上限一起考虑。
API_WORKERS=1

# 宿主机发布端口；Uvicorn 在容器内始终监听 8000。
API_PORT=8000

# API 容器的 CPU 与内存上限。
API_CPUS=2.0
API_MEMORY_LIMIT=1g

# --- logrotate sidecar ---

# 轮转服务保持轻量，其资源不随 API 容量设置扩张。
LOGROTATE_CPUS=0.25
LOGROTATE_MEMORY_LIMIT=64m

# --- 容器 stdout/stderr 日志滚动（Docker local driver） ---

# 单个日志文件大小上限与保留文件数；只作用于容器控制台输出，与应用 app.log 相互独立。
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# 宿主机凭据文件路径，只读挂载到容器 /app/.secrets；文件内不得包含 APP_ENV。
APP_SECRETS_FILE=./.secrets
