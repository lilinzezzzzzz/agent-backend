# Docker Compose deployment parameters. Copy this file to .env before running
# compose.prod.yaml. Do not put application secrets in this file.
COMPOSE_PROJECT_NAME=agent-backend

AGENT_BACKEND_IMAGE=agent-backend:prod
LOGROTATE_IMAGE=agent-backend-logrotate:3.21.0
LOGROTATE_ALPINE_REPOSITORY=https://dl-cdn.alpinelinux.org/alpine/v3.22
AGENT_BACKEND_LOG_DIR=/var/log/agent-backend

API_WORKERS=2
API_PORT=8000
API_CPUS=2.0
API_MEMORY_LIMIT=1g

LOGROTATE_CPUS=0.25
LOGROTATE_MEMORY_LIMIT=64m

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

APP_CONFIG_ENV=prod
APP_ENV_FILE=./configs/.env.prod
APP_SECRETS_FILE=./configs/.secrets
