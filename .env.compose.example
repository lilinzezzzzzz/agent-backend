# Docker Compose 部署参数；应用参数在 configs/app.<APP_ENV>.toml，凭据在 .secrets。
# 新部署复制为根 .env；已有部署手动合并，不能覆盖现有配置。
# 宿主机 journald 持久化需单独设置，见 docs/logging/log_rotation.md。

# 稳定项目名：跨发布保持不变；与 APP_ENV 组合生成固定日志标签。
COMPOSE_PROJECT_NAME=agent-backend

# Compose 注入 APP_ENV 并只读挂载对应环境配置；应用不读取其他 Compose 参数。
# 所选环境必须 LOG_WRITE_TO_FILE=false、LOG_WRITE_TO_CONSOLE=true。
APP_ENV=prod

AGENT_BACKEND_IMAGE=agent-backend:prod

# Uvicorn 进程数，结合容器资源、下游连接预算与压测调整。
API_WORKERS=1
API_PORT=8000
API_CPUS=2.0
API_MEMORY_LIMIT=1g

# 只读挂载到 /app/.secrets；文件不能包含 APP_ENV。
APP_SECRETS_FILE=./.secrets
