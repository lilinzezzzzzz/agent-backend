# =========================================================
# 项目根目录密钥配置文件示例
# 复制此文件为 .secrets 并填入真实值
# APP_ENV 只在仓库根目录 .env 中维护，不要写入本文件。
# 非敏感运行参数只允许写入 configs/.env.<APP_ENV>，本文件只允许包含应用支持的凭据字段。
# 除 APP_ENV 外，应用不会从 shell 环境变量兜底读取配置；缺少必填字段时启动失败。
# 出现白名单以外的 key 同样会导致启动失败；Compose 部署时本文件只读挂载到容器 /app/.secrets，
# 宿主机权限需允许镜像内 app 用户的数字 UID/GID 读取（如 chown 0400）。
# =========================================================

# =========================================================
# 应用密钥
# =========================================================

# AES 解密密钥（用于解密配置中 ENC(...) 格式的加密值）
AES_SECRET=your_aes_secret_key

# JWT 签名密钥（更换后已签发的 access token 立即失效）
JWT_SECRET=your_jwt_secret_key

# =========================================================
# 数据存储凭据
# =========================================================

# 数据库密码（支持 ENC(...) 加密值）
DB_PASSWORD=your_db_password

# 只读副本密码（可选）：启用读写分离时才需要，同时在 configs/.env.<APP_ENV> 配置 DB_READ_HOST 等字段。
# DB_READ_PASSWORD=your_db_read_password

# Redis 密码（支持 ENC(...) 加密值；无密码时留空）
REDIS_PASSWORD=your_redis_password

# =========================================================
# 第三方登录
# =========================================================

# ----- 微信开放平台配置 -----
# 在 https://open.weixin.qq.com/ 申请
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ----- 支付宝开放平台配置（预留） -----
# 在 https://open.alipay.com/ 申请
# ALIPAY_APP_ID=your_alipay_app_id
# ALIPAY_PRIVATE_KEY=your_alipay_private_key
# ALIPAY_PUBLIC_KEY=your_alipay_public_key

# =========================================================
# LLM 配置
# =========================================================

# 默认 provider 通常在 configs/.env.<APP_ENV> 中配置；如需本地覆盖可取消注释。
# LLM_DEFAULT_PROVIDER=deepseek

# 新 provider 使用 LLM_<PROVIDER>_API_KEY，例如 LLM_OPENAI_API_KEY。
# 缺少所选 provider（LLM_DEFAULT_PROVIDER）对应的 key、base_url 或 model 时，LLM 接口返回 503。
LLM_MIMO_API_KEY=your_mimo_api_key
LLM_DEEPSEEK_API_KEY=your_deepseek_api_key

# =========================================================
# Embedding 配置
# =========================================================

# OpenAI-compatible embedding 服务 API key。服务无鉴权时留空。
EMBEDDING_API_KEY=
