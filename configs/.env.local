# =========================================================
# 应用运行参数 · APP_ENV=local
#
# - 本文件只放非敏感参数；凭据统一写在仓库根目录 .secrets。
# - 密钥字段（*_PASSWORD / *_SECRET / *_API_KEY 等）出现在本文件会导致启动失败。
# - 四个环境文件保持同名 key；关闭能力用明确取值表达，不靠缺失字段表达。
# - 运行时只加载本文件与 .secrets；除 APP_ENV 外不从 shell 环境变量兜底读取配置。
# - Compose 部署时本文件按 APP_ENV 只读挂载到容器内 /app/configs/.env.local。
# =========================================================

# --- 运行与调试 ---

# 调试模式；true 时暴露 /docs、/redoc 并输出更详细的错误信息，生产必须为 false。
DEBUG=true

# 日志格式：text 便于本地阅读，json 便于集中采集与检索。
LOG_FORMAT=text

# 日志文件根目录；相对路径按仓库根目录解析。LOG_WRITE_TO_FILE=true 时必填。
LOG_BASE_DIR=logs

# 是否追加写入 <LOG_BASE_DIR>/app.log；应用内不做轮转，长期开启必须配外部 logrotate。
LOG_WRITE_TO_FILE=true

# 是否输出到控制台；与 LOG_WRITE_TO_FILE 不能同时为 false。
LOG_WRITE_TO_CONSOLE=true

# 启动配置回显是否显示敏感值；仅本地诊断时临时开启，默认保持 false。
CONFIG_ECHO_REVEAL_SECRETS=false

# CORS 允许来源（JSON 数组）；["*"] 只适合本地开发，部署环境应替换为具体域名。
BACKEND_CORS_ORIGINS=["*"]

# 微信登录授权类型，授权码模式固定为 authorization_code。
WECHAT_GRANT_TYPE=authorization_code

# --- OpenTelemetry ---

# 是否启用链路追踪；true 时必须配置 OTEL_EXPORTER_OTLP_TRACES_ENDPOINT。
OTEL_TRACING_ENABLED=true

# 上报到 Collector 的 service.name。
OTEL_SERVICE_NAME=agent-backend

# OTLP/HTTP Trace 接收地址（含 /v1/traces 路径）。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://119.23.146.168:4318/v1/traces

# 单次导出超时（秒）。
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10

# --- 认证与令牌 ---

# access token 的签名算法，签发与校验两侧必须一致。
JWT_ALGORITHM=HS256

# --- 数据库（主库） ---

# 数据库类型：mysql 或 postgresql，决定使用的驱动。
DB_TYPE=postgresql

# 主库地址、端口、用户名与库名；密码写在 .secrets 的 DB_PASSWORD。
DB_HOST=119.23.146.168
DB_PORT=5432
DB_USERNAME=postgres
DB_DATABASE=agent_backend

# 是否打印 SQL 语句；本地排查用，生产保持 false。
DB_ECHO=true

# 只读副本为条件配置：需要读写分离时在本文件补充 DB_READ_HOST / DB_READ_PORT /
# DB_READ_USERNAME / DB_READ_DATABASE，并在 .secrets 增加 DB_READ_PASSWORD；
# 未配置 DB_READ_HOST 时读会话回落到主库。

# --- Redis ---

# Redis 地址；密码写在 .secrets 的 REDIS_PASSWORD，无密码时留空。
REDIS_HOST=119.23.146.168

# 逻辑库编号；各环境使用不同 DB 便于隔离数据。
REDIS_DB=1

# Redis 端口。
REDIS_PORT=6379

# --- Celery PostgreSQL 幂等状态机 ---

# 是否启用基于 PostgreSQL 的幂等状态机；开启要求 DB_TYPE=postgresql。
CELERY_IDEMPOTENCY_ENABLED=true

# task time limit 之外的状态收敛宽限（秒），上限 300。
CELERY_EXECUTION_DEADLINE_GRACE_SECONDS=30

# 消息确认入队后允许等待 Worker claim 的时间（秒）；必须大于 CELERY_RECONCILER_INTERVAL_SECONDS。
CELERY_QUEUE_START_TIMEOUT_SECONDS=300

# SUBMITTING 发布确认超时（秒）；必须大于 CELERY_PUBLISH_RECONCILER_INTERVAL_SECONDS。
CELERY_PUBLISH_CONFIRM_TIMEOUT_SECONDS=30

# 发布确认 Reconciler 周期（秒）。
CELERY_PUBLISH_RECONCILER_INTERVAL_SECONDS=10

# ORPHANED 状态外部副作用隔离窗口（秒）。
CELERY_ORPHAN_FENCE_SECONDS=300

# 是否由 Beat 周期触发 deadline Reconciler。
CELERY_RECONCILER_BEAT_ENABLED=true

# deadline Reconciler 周期（秒）。
CELERY_RECONCILER_INTERVAL_SECONDS=60

# deadline Reconciler 单轮收敛记录数上限。
CELERY_RECONCILER_BATCH_SIZE=100

# Reconciler 专用队列名，需与 Worker 的 -Q 列表一致。
CELERY_RECONCILER_QUEUE=celery_maintenance_queue

# 单个任务载荷上限（字节），超过即拒绝；262144 = 256 KiB。
CELERY_TASK_MAX_PAYLOAD_BYTES=262144

# --- 令牌有效期与 Agent 动作 ---

# access token 有效期（秒）；1800 = 30 分钟。
ACCESS_TOKEN_EXPIRE_SECONDS=1800

# 待确认 Agent 动作的有效期（秒），超时后确认失效。
AGENT_ACTION_CONFIRMATION_SECONDS=300

# Agent 动作幂等窗口（秒）；同一幂等键在窗口内只执行一次。
AGENT_ACTION_IDEMPOTENCY_SECONDS=86400

# --- Agent 受管理运行（打断 / 恢复） ---

# 执行者 lease 时长（秒）；超时未续租的 run 允许被下一次 resume 原子接管。
AGENT_LEASE_SECONDS=30

# heartbeat / control 轮询周期（秒）；必须小于 AGENT_LEASE_SECONDS。
AGENT_CONTROL_POLL_SECONDS=5

# 取消收尾预算（秒）；必须覆盖一次 LLM 调用的剩余超时与 checkpoint 提交预算，上限 300。
AGENT_CANCEL_GRACE_SECONDS=70

# 执行事件到响应发送之间的有界通道容量；通道积压说明客户端消费过慢。
AGENT_STREAM_BUFFER_SIZE=16

# 单个 checkpoint JSON 的大小上限（字节）；超出时明确失败而不是截断后继续推理。
AGENT_CHECKPOINT_MAX_BYTES=1048576

# Agent LLM 调用超时（秒）；必须被 AGENT_CANCEL_GRACE_SECONDS 覆盖。
AGENT_LLM_TIMEOUT_SECONDS=60

# --- RAG 检索范围 ---

# 允许检索的知识域白名单（JSON 数组），与请求域取交集；为空会返回 rag_scope_empty。
RAG_ALLOWED_DOMAINS=["order","payment","general"]

# 允许检索的知识库 ID 白名单（JSON 数组，只接受 >0 的值），同样与请求取交集。
RAG_ALLOWED_KB_IDS=[1,2,3]

# 拼装进 prompt 的检索上下文最大字符数。
RAG_MAX_CONTEXT_CHARS=12000

# --- LLM（Chat / Agent 推理） ---

# 默认 provider 标识；实际读取 LLM_<PROVIDER>_BASE_URL / _MODEL / _API_KEY，缺失时接口返回 503。
LLM_DEFAULT_PROVIDER=mimo

# 小米 MiMo provider 的地址与模型；服务与模型必须支持 Responses API，API key 写在 .secrets。
LLM_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MIMO_MODEL=mimo-v2.5-pro

# DeepSeek provider 的地址与模型；API key 写在 .secrets。
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-v4-flash

# --- Embedding（向量化） ---

# provider 类型；当前仅支持 openai_compatible（OpenAI-compatible /embeddings 协议）。
EMBEDDING_PROVIDER=openai_compatible

# embedding 服务地址与模型名；API key 写在 .secrets，服务无鉴权时留空。
EMBEDDING_BASE_URL=http://bge-embedding:8000/v1
EMBEDDING_MODEL=bge-m3

# 向量维度；必须与模型输出维度和向量 collection schema 一致，改动需重建集合。
EMBEDDING_DIMENSION=1024

# 单次向量化请求超时（秒）。
EMBEDDING_TIMEOUT_SECONDS=60

# --- 向量库 Milvus ---

# Milvus 地址（http(s)://host:port）。
MILVUS_URI=http://119.23.146.168:19530

# Milvus database 名，不能为空。
MILVUS_DB_NAME=default

# Milvus 连接与请求超时（秒）。
MILVUS_TIMEOUT_SECONDS=10

# --- Endpoint Guard（指定 endpoint 的禁用 / 拒绝） ---

# 是否启用 endpoint guard 中间件。
ENDPOINT_GUARD_ENABLED=true

# 规则来源：settings（本文件静态规则）、redis（动态下发）、settings+redis（两者合并）。
ENDPOINT_GUARD_SOURCE=settings

# settings 来源的规则，JSON 数组字符串；[] 表示没有静态规则。
ENDPOINT_GUARD_RULES=[]

# Redis 中存放规则的 key（来源包含 redis 时生效）。
ENDPOINT_GUARD_REDIS_KEY=endpoint_guard:rules

# 规则缓存 TTL（秒）；调小可让规则变更更快生效。
ENDPOINT_GUARD_CACHE_TTL_SECONDS=10

# Redis 不可用时的策略：true 放行（fail-open），false 拦截（fail-closed）。
ENDPOINT_GUARD_FAIL_OPEN=true
