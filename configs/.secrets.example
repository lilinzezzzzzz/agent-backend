# =========================================================
# 密钥配置文件示例
# 复制此文件为 .secrets 并填入真实值
# =========================================================

# 环境标识（必填）: local, dev, test, prod
APP_ENV=local

# AES 解密密钥（用于解密配置中 ENC(...) 格式的加密值）
AES_SECRET=your_aes_secret_key

# JWT 签名密钥
JWT_SECRET=your_jwt_secret_key

# 数据库密码（支持 ENC(...) 加密值）
DB_PASSWORD=your_db_password
# DB_READ_PASSWORD=your_db_read_password

# Redis 密码（支持 ENC(...) 加密值；无密码时留空）
REDIS_PASSWORD=your_redis_password

# =========================================================
# 第三方登录配置
# =========================================================

# ----- 微信开放平台配置 -----
# 在 https://open.weixin.qq.com/ 申请
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_GRANT_TYPE=authorization_code

# =========================================================
# 大模型 API Key
# =========================================================

# 默认 provider 在 configs/.env.<APP_ENV> 的 LLM_DEFAULT_PROVIDER 中配置。
# 新 provider 使用 LLM_<PROVIDER>_API_KEY，例如 LLM_OPENAI_API_KEY。
LLM_MIMO_API_KEY=your_mimo_api_key
LLM_DEEPSEEK_API_KEY=your_deepseek_api_key

# ----- 支付宝开放平台配置（预留） -----
# 在 https://open.alipay.com/ 申请
# ALIPAY_APP_ID=your_alipay_app_id
# ALIPAY_PRIVATE_KEY=your_alipay_private_key
# ALIPAY_PUBLIC_KEY=your_alipay_public_key

# 是否完整打印配置信息；false 时会脱敏 .secrets 中的敏感配置
ECHO_CONFIG=false
