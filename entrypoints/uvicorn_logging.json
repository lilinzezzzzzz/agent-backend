{
  "version": 1,
  "disable_existing_loggers": false,
  "handlers": {
    "loguru": {
      "()": "internal.infra.logging.create_uvicorn_log_handler"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["loguru"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": [],
      "level": "INFO",
      "propagate": true
    },
    "uvicorn.access": {
      "handlers": ["loguru"],
      "level": "INFO",
      "propagate": false
    }
  }
}
